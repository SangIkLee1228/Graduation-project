# 원본 데이터 (대용량)
data/raw/*
!data/raw/.gitkeep

# 재생성 가능한 전처리 데이터
data/processed/*.parquet
data/processed/*.jsonl
data/processed/*.pkl
data/processed/london_reviews.json
data/splits/*
!data/splits/.gitkeep

# 새 대용량 모델 및 실행 산출물 (기존 추적 파일은 유지)
artifacts/**/*.npy
artifacts/**/*.pt
experiments/

# Python 환경 및 로컬 설정
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.DS_Store
